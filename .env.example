# ==============================================================================
# CLIENTPULSE VAULT PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# OPTION 1: Published Google Sheet / Online Excel CSV Feed URL (Read-Only)
VITE_SHEET_SYNC_URL=

# OPTION 2: Private Google Sheet via Google Sheets API v4
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_SPREADSHEET_ID=
VITE_GOOGLE_SHEET_NAME=Sheet1

# OPTION 3: 2-Way Read & Write Google Apps Script Web App (RECOMMENDED BI-DIRECTIONAL SYNC)
VITE_CUSTOM_API_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_SHEET_WRITE_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Auto-sync interval in seconds (default: 10 seconds)
VITE_AUTO_SYNC_INTERVAL_SEC=10

# Master Vault Security PIN (e.g. 1234)
VITE_MASTER_SECURITY_PIN=1234
